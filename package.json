{
  "name": "slow-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ambient focus scenes with Creative Commons music.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "check": "node scripts/check.mjs",
    "fetch-music": "node scripts/fetch-music.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run lint && npm run check && npm run build && npm run smoke",
    "portrait": "node scripts/portrait.mjs",
    "build:android": "node scripts/build-native.mjs",
    "apk": "node scripts/build-native.mjs && cd android && ./gradlew assembleDebug",
    "smoke:quick": "SMOKE_SCENES='Rain on Glass,Lava Lamp,Supercell,Holmestrand,Offshore Wind,Pixel Woods,Deep Field,Spectrum Bars,Cat on the Windowsill,Open Water' node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "three": "^0.169.0"
  }
}
