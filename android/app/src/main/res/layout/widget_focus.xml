<?xml version="1.0" encoding="utf-8"?>
<!-- The Focus widget: today's minutes, the streak, and a Start button that opens the app on a focus block. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Focus today" android:textColor="#B3AB9B" android:textSize="11sp" android:letterSpacing="0.12" android:textAllCaps="true" />
        <TextView android:id="@+id/widget_minutes" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 min" android:textColor="#ECE6DA" android:textSize="26sp" android:fontFamily="sans-serif-light" />
        <TextView android:id="@+id/widget_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="No streak yet" android:textColor="#B3AB9B" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_start" android:layout_width="wrap_content" android:layout_height="36dp"
        android:paddingLeft="18dp" android:paddingRight="18dp" android:gravity="center"
        android:text="Start" android:textColor="#111111" android:textSize="14sp" android:background="@drawable/widget_btn" />
</LinearLayout>
